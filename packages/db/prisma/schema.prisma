// ========== Phase B: 写作资产真源 ==========

model Character {
  id               String           @id @default(uuid()) @db.Uuid
  organizationId   String           @map("organization_id") @db.Uuid
  projectId        String           @map("project_id") @db.Uuid
  name             String           @db.VarChar(120)
  aliases          Json?            // string[]
  roleType         String           @map("role_type") @db.VarChar(40) // protagonist | antagonist | supporting | minor
  appearance       String?          @db.Text
  personality      String?          @db.Text
  motivation       String?          @db.Text
  speechPattern    String?          @map("speech_pattern") @db.Text
  knowledgeBoundary Json?           @map("knowledge_boundary") // { knows: string[], unknown: string[] }
  arc              String?          @db.Text
  constraints      String?          @db.Text
  status           String           @default("active") @map("status") @db.VarChar(20) // active | archived
  metadata         Json?
  createdById      String           @map("created_by") @db.Uuid
  createdAt        DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?        @map("deleted_at") @db.Timestamptz(6)
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project          Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy        User             @relation("CharacterCreatedBy", fields: [createdById], references: [id])
  sourceRelations  CharacterRelationship[] @relation("SourceCharacter")
  targetRelations  CharacterRelationship[] @relation("TargetCharacter")

  @@unique([projectId, name], map: "characters_project_id_name_key")
  @@index([organizationId, projectId, status], map: "idx_characters_org_project_status")
  @@index([projectId, roleType], map: "idx_characters_project_role")
  @@map("characters")
}

model CharacterRelationship {
  id                  String    @id @default(uuid()) @db.Uuid
  organizationId      String    @map("organization_id") @db.Uuid
  projectId           String    @map("project_id") @db.Uuid
  sourceCharacterId   String    @map("source_character_id") @db.Uuid
  targetCharacterId   String    @map("target_character_id") @db.Uuid
  relationType        String    @map("relation_type") @db.VarChar(60)
  strength            String?   @db.VarChar(20) // strong | moderate | weak
  status              String    @default("active") @db.VarChar(20) // active | changed | dissolved
  isHidden            Boolean   @default(false) @map("is_hidden")
  evidence            Json?     // { text: string, chapter_id?: string }[]
  changedAtChapterId  String?   @map("changed_at_chapter_id") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project             Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sourceCharacter     Character @relation("SourceCharacter", fields: [sourceCharacterId], references: [id], onDelete: Cascade)
  targetCharacter     Character @relation("TargetCharacter", fields: [targetCharacterId], references: [id], onDelete: Cascade)
  changedAtChapter    Chapter?  @relation("RelationshipChapter", fields: [changedAtChapterId], references: [id])

  @@unique([projectId, sourceCharacterId, targetCharacterId, relationType], map: "character_relationships_unique")
  @@index([organizationId, projectId, status], map: "idx_character_relationships_org_project")
  @@index([sourceCharacterId], map: "idx_character_relationships_source")
  @@index([targetCharacterId], map: "idx_character_relationships_target")
  @@map("character_relationships")
}

model WorldItem {
  id                 String    @id @default(uuid()) @db.Uuid
  organizationId     String    @map("organization_id") @db.Uuid
  projectId          String    @map("project_id") @db.Uuid
  itemType           String    @map("item_type") @db.VarChar(40) // location | faction | artifact | rule | power_system | timeline_event | creature | other
  name               String    @db.VarChar(160)
  aliases            Json?     // string[]
  summary            String?   @db.Text
  detail             String?   @db.Text
  constraints        String?   @db.Text
  activationKeywords Json?     @map("activation_keywords") // string[]
  priority           Int       @default(0)
  status             String    @default("active") @db.VarChar(20) // active | archived
  metadata           Json?
  createdById        String    @map("created_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz(6)
  organization       Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project            Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdBy          User      @relation("WorldItemCreatedBy", fields: [createdById], references: [id])

  @@unique([projectId, itemType, name], map: "world_items_project_id_item_type_name_key")
  @@index([organizationId, projectId, itemType], map: "idx_world_items_org_project_type")
  @@index([projectId, priority], map: "idx_world_items_project_priority")
  @@map("world_items")
}

model PlotThread {
  id                    String    @id @default(uuid()) @db.Uuid
  organizationId        String    @map("organization_id") @db.Uuid
  projectId             String    @map("project_id") @db.Uuid
  threadType            String    @map("thread_type") @db.VarChar(40) // main | side | foreshadowing | mystery | conflict
  title                 String    @db.VarChar(200)
  description           String?   @db.Text
  status                String    @default("planted") @db.VarChar(20) // planted | progressing | deferred | resolved | abandoned
  plantedChapterId      String?   @map("planted_chapter_id") @db.Uuid
  expectedPayoffChapterId String? @map("expected_payoff_chapter_id") @db.Uuid
  resolvedChapterId     String?   @map("resolved_chapter_id") @db.Uuid
  cooldownUntilChapterNo Int?     @map("cooldown_until_chapter_no")
  priority              Int       @default(0)
  dependencies          Json?     // { thread_id: string, note?: string }[]
  evidence              Json?     // { text: string, chapter_id?: string }[]
  createdById           String    @map("created_by") @db.Uuid
  createdAt             DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime? @map("deleted_at") @db.Timestamptz(6)
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  project               Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  plantedChapter        Chapter?  @relation("PlantedChapter", fields: [plantedChapterId], references: [id])
  expectedPayoffChapter Chapter?  @relation("ExpectedPayoffChapter", fields: [expectedPayoffChapterId], references: [id])
  resolvedChapter       Chapter?  @relation("ResolvedChapter", fields: [resolvedChapterId], references: [id])
  createdBy             User      @relation("PlotThreadCreatedBy", fields: [createdById], references: [id])

  @@index([organizationId, projectId, status, priority], map: "idx_plot_threads_org_project_status")
  @@index([projectId, expectedPayoffChapterId], map: "idx_plot_threads_expected_payoff")
  @@index([projectId, status], map: "idx_plot_threads_project_status")
  @@map("plot_threads")
}

model ProjectMemory {
  id              String    @id @default(uuid()) @db.Uuid
  organizationId  String    @map("organization_id") @db.Uuid
  projectId       String    @map("project_id") @db.Uuid
  memoryType      String    @map("memory_type") @db.VarChar(40) // chapter_summary | volume_summary | character_state | world_fact | hook_status | style_note | continuity_note
  scopeType       String    @map("scope_type") @db.VarChar(40) // project | volume | chapter | character | world_item | plot_thread
  scopeId         String?   @map("scope_id") @db.Uuid
  content         String    @db.Text
  contentJson     Json?     @map("content_json")
  sourceChapterId String?   @map("source_chapter_id") @db.Uuid
  sourceJobId     String?   @map("source_job_id") @db.Uuid
  confidence      Int?      @default(100)
  status          String    @default("proposed") @db.VarChar(20) // proposed | accepted | rejected | superseded
  metadata        Json?
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)
