  @@index([organizationId, projectId, memoryType, scopeType, scopeId], map: "idx_project_memories_lookup")
  @@index([projectId, status, createdAt], map: "idx_project_memories_project_status")
  @@index([projectId, memoryType], map: "idx_project_memories_type")
