# Next.js 仅读取 apps/web/.env.local（不会自动读上级 .env）。
# 把本地开发所需变量都放这里。Worker 仍读根 .env（tsx --env-file）。

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ai_novel_platform?schema=public"
QUEUE_DRIVER="postgres"
APP_URL="http://localhost:3000"
DEFAULT_ORGANIZATION_ID="00000000-0000-0000-0000-000000000001"
DEFAULT_USER_ID="00000000-0000-0000-0000-000000000002"
SESSION_SECRET="local-dev-session-secret-please-rotate-32chars-min"

# 设为 true 时所有 AI 端点（章节生成 / 草稿 / 测试连接）走演示模型，无需 API key。
USE_FAKE_MODEL="true"

# 真实模式必填：64 位十六进制，用于加密 model_providers.encrypted_api_key
# ENCRYPTION_KEY=""
